# LLM providers (LiteLLM-style model strings, see optiflow/core/config.py)
CLOUD_MODEL=gemini/gemini-flash-lite-latest
STRONG_MODEL=openai/gpt-4o-mini
LOCAL_MODEL=ollama/qwen2.5-coder:7b
# Model for the LLM judge; ideally a different family from the Strategist's.
JUDGE_MODEL=gemini/gemini-flash-lite-latest

GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# single-cloud | single-local | mixed. single-cloud needs only CLOUD_MODEL's key;
# mixed needs Ollama for the tool agents and STRONG_MODEL's key for Strategist/Transformer.
MODEL_ASSIGNMENT=single-cloud

# Run budget
MAX_ATTEMPTS=5
MAX_USD_PER_RUN=0.05

# Sandbox
SANDBOX_IMAGE=optiflow-sandbox
SANDBOX_CPUSET=2

# CrewAI usage telemetry (sent to CrewAI) is disabled by default; set false to allow it.
CREWAI_DISABLE_TELEMETRY=true

# Deployment: protects POST /api/runs when set (required for a public VM).
OPTIFLOW_API_TOKEN=
# Shared candidate build dir (docker-compose sets this; leave empty locally).
OPTIFLOW_WORKDIR=
# Use an already-running A2A reviewer instead of spawning one (docker-compose sets this).
OPTIFLOW_A2A_URL=
